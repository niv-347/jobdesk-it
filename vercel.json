{
  "version": 2,
  "framework": null,
  "docker": {
    "dockerfile": "Dockerfile"
  },
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "env": {
    "PHP_VERSION": "8.4"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
